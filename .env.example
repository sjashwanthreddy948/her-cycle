# HerCycle Environment Variables
# For cloud deployment with Supabase, provide your project credentials:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# When VITE_SUPABASE_URL is empty, HerCycle automatically operates
# using its built-in full-fidelity persistent local storage engine
# with 5-6 months of realistic seeded demo data for Sarah & Alex.
